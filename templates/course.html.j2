{% import 'macros.j2' as m %}
{{ m.head(
  title='宴会・コース｜松山市の居酒屋 愛媛の雅ちゃん',
  description='松山市駅徒歩1分の居酒屋「愛媛の雅ちゃん」の宴会・コース。満喫コース・親雛コース・揚げ鳥コースと飲み放題のご案内。',
  canonical='https://dohiwebc.github.io/ehimenomasa/course.html',
  css_v=css_v
) }}
<body>
{{ m.site_header(current='course') }}
<main id="main">
  <section class="page-hero" style="background-image:url('assets/images/site/course-mankitsu.webp');">
    <div class="container">
      <p class="kicker">愛媛の雅ちゃん</p>
      <h1 class="page-hero__title">宴会・コース</h1>
      <p class="page-hero__lead">コース8品 ＋ 飲み放題120分付</p>
    </div>
  </section>

  <aside class="notice-rail reveal" aria-label="コースご利用にあたって">
    <ol class="notice-rail__list">
      <li>
        <span class="notice-rail__index" aria-hidden="true">01</span>
        <p class="notice-rail__text">価格は全て税込表示です。</p>
      </li>
      <li>
        <span class="notice-rail__index" aria-hidden="true">02</span>
        <p class="notice-rail__text">コースメニューは2名様以上の前日予約が必要です。<span class="notice-rail__sub">当日予約希望の場合もご相談ください</span></p>
      </li>
      <li>
        <span class="notice-rail__index" aria-hidden="true">03</span>
        <p class="notice-rail__text">コースメニューの内容は、<br class="br-sp">一部変更になる場合がございます。</p>
      </li>
    </ol>
  </aside>

  {% for c in courses %}
  <article class="course-detail{% if loop.index is even %} course-detail--flip{% endif %} reveal">
    {% if c.image %}
    <div class="course-detail__media">
      <img src="{{ c.image }}" alt="{{ c.name }}の料理一例" width="800" height="600" loading="lazy" decoding="async">
    </div>
    {% endif %}
    <div class="course-detail__content">
      <div class="course-detail__head">
        <h2 class="course-detail__name">{{ c.name }}</h2>
        <p class="price">{{ c.price_label }}</p>
      </div>
      {% if c.lead %}<p class="course-detail__lead">{{ c.lead }}</p>{% endif %}
      {% if c.lines %}
      <ul class="course-detail__list">
        {% for line in c.lines %}
        <li>{{ line }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </article>
  {% endfor %}

  <section class="section section--photo cta-final" style="background-image:url('assets/images/site/interior-dining.webp');">
    <div class="container reveal">
      <h2 class="section-title">コースのご予約はこちら</h2>
      <div class="btn-group">
        <a class="btn btn--primary" href="reserve.html">席を予約する</a>
        <a class="btn btn--ghost" href="menu.html">お品書きを見る</a>
      </div>
    </div>
  </section>
</main>
{{ m.site_footer(site=site, access=access, tel=tel, css_v=css_v) }}
</body>
</html>
