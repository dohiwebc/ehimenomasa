{# TOP 名物（外側の .meibutsu-list は index 側） #}
{% if meibutsu_rows %}
{% for row in meibutsu_rows %}
<div class="meibutsu-list__row meibutsu-list__row--{{ row|length }}">
  {% for item in row %}
  <article class="meibutsu-item reveal">
    {% if item.image %}
    <div class="meibutsu-item__media">
      <img src="{{ item.image }}" alt="{{ item.name }}" width="800" height="533" loading="lazy" decoding="async">
      {% if '（ひな）' in item.name %}<span class="popular-label" aria-label="人気No.1"><span class="popular-label__kicker">人気</span><span class="popular-label__rank">No.1</span></span>{% elif '（おや）' in item.name %}<span class="popular-label" aria-label="人気No.2"><span class="popular-label__kicker">人気</span><span class="popular-label__rank">No.2</span></span>{% endif %}
    </div>
    {% endif %}
    <div class="meibutsu-item__body">
      {% if item.place %}<p class="meibutsu-item__place">{{ item.place }}</p>{% endif %}
      <h3 class="meibutsu-item__name">{{ item.name }}</h3>
      {% if item.price_label %}<p class="price">{{ item.price_label }}</p>{% endif %}
    </div>
  </article>
  {% endfor %}
</div>
{% endfor %}
{% endif %}
