{% import 'macros.j2' as m %}
{{ m.head(
  title='スタッフ募集｜松山市駅の居酒屋 愛媛の雅ちゃん',
  description='松山市駅すぐの居酒屋「愛媛の雅ちゃん」のスタッフ募集。正社員（キッチン・ホール）とアルバイトを募集中。',
  canonical='https://ehimenomasa.com/recruit.html',
  css_v=css_v
) }}
<body class="page-recruit">
{{ m.site_header(current='recruit') }}
<main id="main">
  <section class="page-hero" style="background-image:url('assets/images/site/interior-dining.webp');">
    <div class="container">
      <p class="kicker">愛媛の雅ちゃん</p>
      <h1 class="page-hero__title">スタッフ募集</h1>
      <p class="page-hero__lead">正社員・アルバイト、どちらも募集中です</p>
    </div>
  </section>
{{ m.breadcrumb('スタッフ募集', 'https://ehimenomasa.com/recruit.html') }}

  {% if not site.recruitOpen %}
  <section class="section">
    <div class="container container--narrow reveal">
      <h2 class="section-title">現在募集を停止しています</h2>
      <p>募集再開までしばらくお待ちください。</p>
    </div>
  </section>
  {% else %}
  <section class="section recruit-hub">
    <div class="container">
      <figure class="recruit-banner reveal">
        <img src="assets/images/site/bnr-work.webp" alt="求ム!! 雅ちゃんで楽しく！元気に！働いてくれる方 スタッフ募集" width="800" height="223" loading="lazy" decoding="async">
      </figure>

      <header class="recruit-switch reveal" data-recruit-switch>
        <p class="kicker recruit-switch__kicker">募集種別</p>
        <div class="recruit-switch__frame">
          <p class="recruit-switch__hint">ボタンを押して、正社員とアルバイトの募集内容を切り替えられます</p>
          <div class="recruit-switch__tabs" role="tablist" aria-label="正社員とアルバイトの募集内容を切り替え">
            <button class="recruit-switch__tab is-active" type="button" role="tab" id="recruit-tab-fulltime" aria-selected="true" aria-controls="recruit-panel-fulltime" data-recruit-tab="fulltime">
              <span class="recruit-switch__tab-label">正社員</span>
              <span class="recruit-switch__tab-note">キッチン・ホール</span>
            </button>
            <button class="recruit-switch__tab" type="button" role="tab" id="recruit-tab-parttime" aria-selected="false" aria-controls="recruit-panel-parttime" data-recruit-tab="parttime" tabindex="-1">
              <span class="recruit-switch__tab-label">アルバイト</span>
              <span class="recruit-switch__tab-note">ホール・キッチン</span>
            </button>
          </div>
        </div>
        <div class="recruit-switch__actions btn-group btn-group--recruit-switch">
          <a class="btn btn--primary" href="#recruit-apply">WEB応募</a>
          <a class="btn btn--line" href="{{ tel }}">
            <span class="btn__icon btn__icon--phone" aria-hidden="true"></span>
            電話（{{ site.phone }}）
          </a>
        </div>
      </header>

      {# --- 正社員 --- #}
      <div class="recruit-panel reveal is-active" id="recruit-panel-fulltime" role="tabpanel" aria-labelledby="recruit-tab-fulltime" data-recruit-panel="fulltime">
        <p class="recruit-panel__lead">居酒屋・調理経験者歓迎。松山市駅から徒歩30秒。</p>

        <table class="company-table company-table--recruit">
          <tr><th>雇用形態</th><td>正社員（キッチン・ホール）。雇用期間の定めなし。派遣・請負ではない。</td></tr>
          <tr><th>給与</th><td>月238,700円〜258,500円（基本給＋固定残業代。詳細は下記）</td></tr>
          <tr><th>勤務時間</th><td>14:00〜23:00（1時間休憩）</td></tr>
          <tr><th>試用期間</th><td>2か月（試用中は時給1,100円）</td></tr>
          <tr><th>勤務地</th><td>健勝ビル2F（松山市駅徒歩30秒）／株式会社 雅道（愛媛の雅ちゃん）</td></tr>
        </table>

        <div class="recruit-split recruit-split--compact">
          <div class="recruit-split__body">
            <h2 class="recruit-subhead recruit-subhead--panel">仕事内容</h2>
            <div class="recruit-job recruit-job--compact">
              <div class="recruit-job__block">
                <h3 class="recruit-job__title">キッチン</h3>
                <ul>
                  <li>居酒屋料理の仕込み、調理（焼き、揚げ調理等）</li>
                  <li>食材の盛り付け等</li>
                </ul>
              </div>
              <div class="recruit-job__block">
                <h3 class="recruit-job__title">ホール</h3>
                <ul>
                  <li>料理の配膳、片付け、清掃、接客等</li>
                </ul>
              </div>
            </div>
            <ul class="recruit-points recruit-points--inline recruit-points--tight">
              <li>制服貸与あり</li>
              <li>即戦力歓迎</li>
              <li>明るく元気でやる気のある方を優先</li>
            </ul>
          </div>
          <div class="recruit-split__media recruit-split__media--single">
            <img src="assets/images/site/hp-counter-live.webp" alt="カウンター席のある店内" width="480" height="480" loading="lazy" decoding="async">
          </div>
        </div>

        <section class="recruit-panel__block">
          <h3 class="recruit-subhead">応募条件</h3>
          <ul class="recruit-points">
            <li>20歳以上（労働基準法等により年齢制限あり）</li>
            <li>学歴不問</li>
            <li>居酒屋業務・調理経験必須（マネージメント経験あれば尚可）</li>
            <li>必要な免許・資格：不問</li>
          </ul>
        </section>

        <section class="recruit-panel__block">
          <h3 class="recruit-subhead">給与・就業場所の詳細</h3>
          <table class="company-table company-table--recruit">
            <tr><th>給与</th><td>月額238,700円〜258,500円<br>基本給210,000円〜220,000円／固定残業代28,700円〜38,500円<br>深夜割増別途／通勤手当・昇給・賞与なし<br>固定残業代は18.2〜23.3時間分。超過分は別途支給（月166.6時間・平均20.8日）</td></tr>
            <tr><th>締日・支払</th><td>締日：毎月末／支払：翌月5日</td></tr>
            <tr><th>就業場所</th><td>〒790-0012 愛媛県松山市湊町5丁目4-2 健勝ビル2F<br>松山市駅から徒歩30秒<br>受動喫煙対策なし（喫煙可・屋内禁煙適用除外）<br>マイカー通勤不可／転勤なし</td></tr>
          </table>
        </section>
      </div>

      {# --- アルバイト --- #}
      <div class="recruit-panel reveal" id="recruit-panel-parttime" role="tabpanel" aria-labelledby="recruit-tab-parttime" data-recruit-panel="parttime" hidden>
        <p class="recruit-panel__lead">週2日〜OK。未経験歓迎。松山市駅から徒歩30秒。</p>

        <table class="company-table company-table--recruit">
          <tr><th>雇用形態</th><td>アルバイト（ホール・キッチン）</td></tr>
          <tr><th>給与</th><td>時給1,100円〜1,250円（試用2か月は1,040円以上／金曜+50円／随時昇給あり）</td></tr>
          <tr><th>勤務時間</th><td>18:00〜23:00／週2日〜／シフト制（2週間ごと）<br>曜日・時間応相談（短時間・扶養内・早上がり相談可）</td></tr>
          <tr><th>休暇</th><td>日曜・祝日休み／夏季1週間／年末年始（12/31〜1/5）／希望休柔軟対応</td></tr>
          <tr><th>勤務地</th><td>健勝ビル2F（松山市駅徒歩30秒）／株式会社雅道</td></tr>
        </table>

        <div class="recruit-split recruit-split--compact">
          <div class="recruit-split__body">
            <h2 class="recruit-subhead recruit-subhead--panel">仕事内容</h2>
            <div class="recruit-job recruit-job--compact">
              <div class="recruit-job__block">
                <h3 class="recruit-job__title">キッチン</h3>
                <ul>
                  <li>仕込み・盛り付け・洗い場等（調理補助メイン）</li>
                </ul>
                <p class="recruit-job__note">料理は店主が中心。サポートが中心です。</p>
              </div>
              <div class="recruit-job__block">
                <h3 class="recruit-job__title">ホール</h3>
                <ul>
                  <li>ドリンク作り・配膳・片付け・接客</li>
                </ul>
              </div>
            </div>
            <ul class="recruit-points recruit-points--inline recruit-points--tight">
              <li>レジ・電話対応なし</li>
              <li>未経験者歓迎</li>
            </ul>
          </div>
          <div class="recruit-split__media recruit-split__media--single">
            <img src="assets/images/site/hp-counter-live.webp" alt="カウンター席のある店内" width="480" height="480" loading="lazy" decoding="async">
          </div>
        </div>

        <section class="recruit-panel__block">
          <h3 class="recruit-subhead">求める人材・歓迎する経験</h3>
          <ul class="recruit-points">
            <li>未経験・学歴不問・無資格歓迎</li>
            <li>学生・フリーター・Wワーク・長期歓迎</li>
            <li>明るく元気な方大歓迎</li>
          </ul>
          <p class="recruit-exp-note">居酒屋・カフェ・コンビニ等の接客・調理補助経験が活かせます（ブランクOK）。</p>
        </section>

        <section class="recruit-panel__block">
          <h3 class="recruit-subhead">アピールポイント</h3>
          <dl class="recruit-appeal recruit-appeal--compact">
            <div class="recruit-appeal__item">
              <dt>シフト柔軟</dt>
              <dd>2週間ごと。短時間・平日のみ・扶養内・早上がり相談可。</dd>
            </div>
            <div class="recruit-appeal__item">
              <dt>駅チカ</dt>
              <dd>松山市駅徒歩30秒。通いやすい立地。</dd>
            </div>
            <div class="recruit-appeal__item">
              <dt>学業両立</dt>
              <dd>週2日〜。授業・終電に合わせた調整可。</dd>
            </div>
            <div class="recruit-appeal__item">
              <dt>まかない</dt>
              <dd>メニューから選べる賄い付き。</dd>
            </div>
          </dl>
        </section>

        <section class="recruit-panel__block">
          <h3 class="recruit-subhead">待遇・福利厚生</h3>
          <ul class="recruit-points">
            <li>まかない・制服貸与</li>
            <li>髪色・ピアス・ネイルOK<span class="recruit-paren">（長ネイルは手袋着用のためNG）</span></li>
            <li>自転車・バイク通勤OK</li>
            <li>社会保険等（法令に則り適用）</li>
          </ul>
        </section>
      </div>
    </div>
  </section>

  <section class="section" id="recruit-apply">
    <div class="container container--narrow reveal">
      <h2 class="section-title">応募方法</h2>
      <p>応募後、1営業日以内にご連絡します。友達と応募もOKです。</p>

      <div class="form-panel form-panel--recruit">
        <p class="form-panel__kicker">Apply</p>
        <h3 class="form-panel__title">WEB応募フォーム</h3>
        <p class="form-panel__lead">希望雇用形態を選び、必要事項をご記入のうえ送信してください。</p>
        <form data-demo-form data-form-type="recruit" novalidate>
          <div class="form-grid">
            <div class="form-group form-group--full">
              <label for="rc-type">希望雇用形態 <span class="req">必須</span></label>
              <select class="form-control" id="rc-type" name="employment_type" required>
                <option value="">選択してください</option>
                <option value="正社員（キッチン・ホール）">正社員（キッチン・ホール）</option>
                <option value="アルバイト・パート">アルバイト・パート</option>
              </select>
            </div>
            <div class="form-group">
              <label for="rc-name">お名前 <span class="req">必須</span></label>
              <input class="form-control" id="rc-name" name="name" type="text" required autocomplete="name" placeholder="山田 太郎">
            </div>
            <div class="form-group">
              <label for="rc-tel">お電話番号 <span class="req">必須</span></label>
              <input class="form-control" id="rc-tel" name="tel" type="tel" required autocomplete="tel" placeholder="090-0000-0000">
            </div>
            <div class="form-group">
              <label for="rc-age">年齢 <span class="req">必須</span></label>
              <div class="form-row form-row--unit">
                <input class="form-control" id="rc-age" name="age" type="number" min="16" max="80" required inputmode="numeric" placeholder="25">
                <span class="form-unit" aria-hidden="true">歳</span>
              </div>
            </div>
            <div class="form-group">
              <label for="rc-days">週の出勤可能日数 <span class="req">必須</span></label>
              <select class="form-control" id="rc-days" name="available_days" required>
                <option value="">選択してください</option>
                <option value="週1日">週1日</option>
                <option value="週2日">週2日</option>
                <option value="週3日">週3日</option>
                <option value="週4日">週4日</option>
                <option value="週5日以上">週5日以上</option>
              </select>
            </div>
            <div class="form-group">
              <label for="rc-email">メールアドレス <span class="opt">任意</span></label>
              <input class="form-control" id="rc-email" name="email" type="email" autocomplete="email" placeholder="example@email.com">
            </div>
            <div class="form-group">
              <label for="rc-experience">飲食経験 <span class="opt">任意</span></label>
              <select class="form-control" id="rc-experience" name="experience">
                <option value="">選択してください</option>
                <option value="あり">あり</option>
                <option value="なし">なし</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="rc-note">自己PR・質問 <span class="opt">任意</span></label>
            <textarea class="form-control" id="rc-note" name="note" rows="4" placeholder="自己PRや質問があればご記入ください"></textarea>
          </div>
          <div class="form-group">
            <div class="form-check">
              <input id="rc-privacy" name="privacy" type="checkbox" required>
              <label for="rc-privacy">個人情報の取り扱いに同意する（<a href="privacy.html">プライバシーポリシー</a>） <span class="req">必須</span></label>
            </div>
          </div>
          <div class="form-turnstile" data-turnstile aria-label="セキュリティ確認"></div>
          <div class="form-actions">
            <button class="btn btn--primary" type="submit">応募内容を送信する</button>
            <a class="btn btn--line" href="{{ tel }}">
              <span class="btn__icon btn__icon--phone" aria-hidden="true"></span>
              電話で応募する（{{ site.phone }}）
            </a>
          </div>
        </form>
      </div>

      <h3 class="recruit-subhead">選考の流れ</h3>
      <ol class="recruit-flow">
        <li>応募</li>
        <li>面接1回</li>
        <li>採用</li>
      </ol>
      <ul class="recruit-points recruit-points--inline">
        <li>履歴書は写真なしでOK</li>
        <li>開始時期調整・職場見学可</li>
      </ul>
      <p class="note" style="margin-top:1.4rem;">WEB応募は24時間受付中です。</p>
    </div>
  </section>
  {% endif %}
</main>
<a class="recruit-sticky" id="recruit-sticky" href="#recruit-apply">応募する</a>
{{ m.site_footer(site=site, access=access, tel=tel, css_v=css_v, mobile_bar='recruit') }}
<script src="js/form-demo.js?v=20260929c"></script>
</body>
</html>
