{% import 'macros.j2' as m %}
{{ m.head(
  title='店内・アクセス｜松山市駅から徒歩1分の居酒屋 愛媛の雅ちゃん',
  description='松山市駅から徒歩1分、健勝ビル2階。店内の雰囲気・アクセス・席のご案内。駐車場はありません。',
  canonical='https://ehimenomasa.com/shop.html',
  css_v=css_v
) }}
<body>
{{ m.site_header(current='shop') }}
<main id="main">
  <section class="page-hero" style="background-image:url('assets/images/site/store-exterior.webp'); background-position:center 18%;">
    <div class="container">
      <p class="kicker">愛媛の雅ちゃん</p>
      <h1 class="page-hero__title">店内・アクセス</h1>
      <p class="page-hero__lead">{% if access.seatInfo %}{{ access.seatInfo | nl2br }}{% else %}松山市駅前の小さな居酒屋。健勝ビル2階。<br>カウンターとテーブルで、仕事帰りから宴会まで。{% endif %}</p>
    </div>
  </section>
{{ m.breadcrumb('店内・アクセス', 'https://ehimenomasa.com/shop.html') }}

  <section class="section shop-intro">
    <div class="container">
      <div class="shop-intro__head reveal">
        <p class="kicker">店舗紹介</p>
        <h2 class="section-title">松山市駅前の、<br>小さな居酒屋です</h2>
        <p class="section-lead">{% if access.seatInfo %}{{ access.seatInfo | nl2br }}{% else %}松山市駅前の小さな居酒屋。健勝ビル2階。<br>カウンターとテーブルで、仕事帰りから宴会まで。{% endif %}</p>
      </div>
      {# ギャラリーは比率・並びがデザインなので CMS 外（静的） #}
      <div class="shop-collage reveal">
        <div class="shop-collage__row">
          <figure style="--ar:1.6495">
            <img src="assets/images/site/interior-counter.webp" alt="店内の「愛媛の雅ちゃん」ロゴ看板" width="800" height="485" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:1.3333">
            <img src="assets/images/site/interior-night.webp" alt="店主の想いが書かれた店内の書" width="800" height="600" loading="lazy" decoding="async">
          </figure>
        </div>
        <div class="shop-collage__row">
          <figure style="--ar:1">
            <img src="assets/images/site/hp-zashiki-12.webp" alt="宴会向けのテーブル席" width="480" height="480" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:1">
            <img src="assets/images/site/hp-zashiki-wide.webp" alt="宴会向けの座敷席" width="480" height="480" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:1">
            <img src="assets/images/site/hp-table-party.webp" alt="テーブル席が並ぶ店内" width="480" height="480" loading="lazy" decoding="async">
          </figure>
        </div>
        <div class="shop-collage__row">
          <figure style="--ar:0.75">
            <img src="assets/images/site/store-exterior.webp" alt="店舗入り口" width="600" height="800" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:1.3333">
            <img src="assets/images/site/interior-dining.webp" alt="テーブル席" width="800" height="600" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:0.75">
            <img src="assets/images/site/store-sign.webp" alt="看板と垂れ幕が並ぶ店舗入り口" width="600" height="800" loading="lazy" decoding="async">
          </figure>
        </div>
        <div class="shop-collage__row">
          <figure style="--ar:1">
            <img src="assets/images/site/hp-counter-seat.webp" alt="セッティングされたカウンター席" width="480" height="480" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:1">
            <img src="assets/images/site/hp-counter-live.webp" alt="カウンター席" width="480" height="480" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:1">
            <img src="assets/images/site/hp-table-seat.webp" alt="テーブル席の様子" width="480" height="480" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:1">
            <img src="assets/images/site/hp-zashiki-6.webp" alt="少人数向けの座敷席" width="480" height="480" loading="lazy" decoding="async">
          </figure>
        </div>
        <div class="shop-collage__row">
          <figure style="--ar:0.75">
            <img src="assets/images/site/shop-gallery-05.webp" alt="2階入り口（階段上）" width="600" height="800" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:0.75">
            <img src="assets/images/site/shop-gallery-04.webp" alt="2階への階段" width="600" height="800" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:1.05">
            <img src="assets/images/site/shop-gallery-20.webp" alt="2階のエレベーター" width="630" height="600" loading="lazy" decoding="async">
          </figure>
          <figure style="--ar:0.96">
            <img src="assets/images/site/shop-gallery-16.webp" alt="収納つきのカウンター椅子" width="576" height="600" loading="lazy" decoding="async">
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="shop-access reveal">
        <div class="shop-access__copy">
          <p class="kicker">Access</p>
          <h2 class="section-title">アクセス</h2>
          <table class="info-table">
            <tr><th>所在地</th><td>{{ access.address }}</td></tr>
            <tr><th>TEL</th><td><a href="{{ tel }}">{{ site.phone }}</a></td></tr>
            {% if access.holiday %}<tr><th>定休日</th><td>{{ access.holiday }}</td></tr>{% endif %}
            {% if access.hours %}<tr><th>営業時間</th><td>{{ access.hours }}</td></tr>{% endif %}
          </table>
          {% if access.accessText %}
          <div class="shop-access__notes">
            <p style="white-space:pre-line;">{{ access.accessText }}</p>
          </div>
          {% endif %}
        </div>
        <div class="shop-access__map">
          {% if access.mapEmbed %}
            {{ access.mapEmbed | safe }}
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sister-block reveal">
        <p class="kicker">Related</p>
        <h2 class="section-title">姉妹店について</h2>
        <p class="section-lead">以下は姉妹店・本家の情報です。<br class="br-sp">松山本店（愛媛の雅ちゃん）とは別店舗です。</p>
        <div class="sister-grid">
          <article class="sister-card">
            <figure class="sister-card__media">
              <img src="assets/images/site/sister-torikichi.webp" alt="本家・とり吉" width="1040" height="800" loading="lazy" decoding="async">
            </figure>
            <h3 class="sister-card__name">本家・とり吉（とりきち）</h3>
            <table class="info-table">
              <tr><th>所在地</th><td>〒799-0113<br>愛媛県四国中央市妻鳥町1342-1</td></tr>
              <tr><th>TEL</th><td>0896-57-1194</td></tr>
              <tr><th>定休日</th><td>月曜日</td></tr>
              <tr><th>営業時間</th><td>16:00～22:00</td></tr>
            </table>
            <iframe class="map-embed map-embed--sm" title="とり吉の地図" src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d26464.51630989305!2d133.576306!3d33.990876!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x755b362f585d12e7!2z44Go44KK5ZCJ!5e0!3m2!1sja!2sjp!4v1640272144428!5m2!1sja!2sjp" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </article>
          <article class="sister-card">
            <figure class="sister-card__media">
              <img src="assets/images/site/sister-fukuwauchi.webp" alt="姉妹店・福○家" width="1040" height="800" loading="lazy" decoding="async">
            </figure>
            <h3 class="sister-card__name">姉妹店・福○家（ふくわうち）</h3>
            <table class="info-table">
              <tr><th>所在地</th><td>〒799-0111<br>愛媛県四国中央市金生町下分222-15</td></tr>
              <tr><th>TEL</th><td>0896-56-1129</td></tr>
              <tr><th>定休日</th><td>日曜日</td></tr>
              <tr><th>営業時間</th><td>昼　11:30～14:00（ラストオーダー 13:30）<br>夜　17:00～22:00（ラストオーダー 21:30）</td></tr>
            </table>
            <iframe class="map-embed map-embed--sm" title="福○家の地図" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d983.31293725094!2d133.57492355829874!3d34.00647098920394!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3551913f52a7e581%3A0xddc72da1a85066dd!2z56aP44KP44GG44Gh!5e0!3m2!1sja!2sjp!4v1640272337245!5m2!1sja!2sjp" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </article>
        </div>
      </div>
    </div>
  </section>
</main>
{{ m.site_footer(site=site, access=access, tel=tel, css_v=css_v) }}
</body>
</html>
