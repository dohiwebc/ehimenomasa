{# 共通マクロ #}
{% macro head(title, description, canonical, css_v, extra_fonts='') -%}
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta name="description" content="{{ description }}">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://ehimenomasa.com/assets/images/site/hero-chicken-dishes.webp">
  <meta property="og:locale" content="ja_JP">
  <meta property="og:site_name" content="愛媛の雅ちゃん">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="assets/icons/favicon-32.webp" sizes="32x32">
  <link rel="icon" href="assets/icons/favicon-192.webp" sizes="192x192">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Old+Mincho:wght@500;600;700{{ extra_fonts }}&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/reset.css">
  <link rel="stylesheet" href="css/style.css?v={{ css_v }}">
  <link rel="stylesheet" href="css/responsive.css?v={{ css_v }}">
</head>
{%- endmacro %}

{% macro site_header(current='', on_hero=false) -%}
  <a class="sr-only" href="#main">本文へスキップ</a>
  <header class="site-header{% if on_hero %} site-header--on-hero is-transparent{% else %} is-solid{% endif %}">
    <div class="site-header__inner">
      <a class="site-logo" href="index.html">
        <img src="assets/images/site/logo-masachan.webp" alt="愛媛の雅ちゃん" width="400" height="146" decoding="async">
      </a>
      <button class="nav-toggle" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="メインメニュー">
        <ul class="site-nav__list">
          <li><a class="site-nav__link" href="index.html"{% if current == 'home' %} aria-current="page"{% endif %}>ホーム</a></li>
          <li><a class="site-nav__link" href="menu.html"{% if current == 'menu' %} aria-current="page"{% endif %}>お品書き</a></li>
          <li><a class="site-nav__link" href="course.html"{% if current == 'course' %} aria-current="page"{% endif %}>宴会・コース</a></li>
          <li><a class="site-nav__link" href="shop.html"{% if current == 'shop' %} aria-current="page"{% endif %}>店内・アクセス</a></li>
          <li><a class="site-nav__link" href="about.html"{% if current == 'about' %} aria-current="page"{% endif %}>雅ちゃんについて</a></li>
          <li><a class="site-nav__link" href="recruit.html"{% if current == 'recruit' %} aria-current="page"{% endif %}>スタッフ募集</a></li>
          <li><a class="site-nav__link" href="takeout.html"{% if current == 'takeout' %} aria-current="page"{% endif %}>テイクアウト</a></li>
          <li><a class="site-nav__link site-nav__reserve" href="reserve.html"{% if current == 'reserve' %} aria-current="page"{% endif %}>ご予約</a></li>
        </ul>
      </nav>
    </div>
  </header>
{%- endmacro %}

{% macro site_footer(site, access, tel, css_v) -%}
  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <img src="assets/images/site/logo-masachan.webp" alt="愛媛の雅ちゃん" width="400" height="146" loading="lazy" decoding="async">
        <p>焼き・揚げ鳥 〜愛媛の雅ちゃん〜</p>
        <p>{{ access.address }}<br>TEL <a href="{{ tel }}">{{ site.phone }}</a></p>
      </div>
      <nav class="footer-nav" aria-label="フッターメニュー">
        <p class="footer-label">メニュー</p>
        <a href="index.html">ホーム</a>
        <a href="menu.html">お品書き</a>
        <a href="course.html">宴会・コース</a>
        <a href="shop.html">店内・アクセス</a>
        <a href="about.html">雅ちゃんについて</a>
        <a href="recruit.html">スタッフ募集</a>
        <a href="takeout.html">テイクアウト</a>
        <a href="reserve.html">ご予約</a>
        <a href="privacy.html">プライバシーポリシー</a>
      </nav>
      <div class="footer-sns">
        <p class="footer-label">各種SNS</p>
        {% if site.instagramUrl %}<a href="{{ site.instagramUrl }}" target="_blank" rel="noopener noreferrer">Instagram</a>{% endif %}
        {% if site.storesUrl %}<a href="{{ site.storesUrl }}" target="_blank" rel="noopener noreferrer">ネットショップ</a>{% endif %}
      </div>
    </div>
    <div class="container footer-copy">
      <p>Copyright © 愛媛の雅ちゃん / 株式会社 雅道</p>
    </div>
  </footer>
  <div class="mobile-bar" aria-label="スマートフォン用クイックアクション">
    <div class="mobile-bar__inner">
      <a class="mobile-bar__btn mobile-bar__btn--reserve" href="reserve.html">予約する</a>
      <a class="mobile-bar__btn mobile-bar__btn--tel" href="{{ tel }}" data-reserve-gate="tel">電話する</a>
    </div>
  </div>
  <script src="js/main.js?v={{ css_v }}"></script>
{%- endmacro %}
