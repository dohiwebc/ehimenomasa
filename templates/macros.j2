{# 共通マクロ #}
{% macro head(title, description, canonical, css_v, extra_fonts='', preload_hero=false) -%}
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="canonical" href="{{ canonical }}">
  <meta name="description" content="{{ description }}">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="theme-color" content="#243b55">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="愛媛の雅ちゃん">
  <meta property="og:locale" content="ja_JP">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="https://ehimenomasa.com/assets/images/site/hero-chicken-dishes.webp">
  <meta property="og:image:width" content="800">
  <meta property="og:image:height" content="600">
  <meta property="og:image:alt" content="愛媛の雅ちゃんの鶏料理">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://ehimenomasa.com/assets/images/site/hero-chicken-dishes.webp">
  <link rel="icon" href="assets/icons/favicon-32.webp" sizes="32x32">
  <link rel="icon" href="assets/icons/favicon-192.webp" sizes="192x192">
  <link rel="apple-touch-icon" href="assets/icons/favicon-192.webp">
  {% if preload_hero %}<link rel="preload" as="image" href="assets/images/site/hero-chicken-dishes.webp" type="image/webp">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Old+Mincho:wght@500;600;700{{ extra_fonts }}&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/reset.css">
  <link rel="stylesheet" href="css/style.css?v=20260923z">
  <link rel="stylesheet" href="css/responsive.css?v=20260923z">
</head>
{%- endmacro %}

{% macro site_header(current='', on_hero=false) -%}
  <a class="sr-only" href="#main">本文へスキップ</a>
  <header class="site-header{% if on_hero %} site-header--on-hero is-transparent{% else %} is-solid{% endif %}">
    <div class="site-header__inner">
      <a class="site-logo" href="index.html">
        <img src="assets/images/site/logo-masachan.webp" alt="愛媛の雅ちゃん" width="400" height="146" decoding="async">
      </a>
      <button class="nav-toggle" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="メインメニュー">
        <ul class="site-nav__list">
          <li><a class="site-nav__link" href="index.html"{% if current == 'home' %} aria-current="page"{% endif %}>ホーム</a></li>
          <li><a class="site-nav__link" href="menu.html"{% if current == 'menu' %} aria-current="page"{% endif %}>お品書き</a></li>
          <li><a class="site-nav__link" href="course.html"{% if current == 'course' %} aria-current="page"{% endif %}>宴会・コース</a></li>
          <li><a class="site-nav__link" href="shop.html"{% if current == 'shop' %} aria-current="page"{% endif %}>店内・アクセス</a></li>
          <li><a class="site-nav__link" href="about.html"{% if current == 'about' %} aria-current="page"{% endif %}>雅ちゃんについて</a></li>
          <li><a class="site-nav__link" href="recruit.html"{% if current == 'recruit' %} aria-current="page"{% endif %}>スタッフ募集</a></li>
          <li><a class="site-nav__link" href="takeout.html"{% if current == 'takeout' %} aria-current="page"{% endif %}>テイクアウト</a></li>
          <li><a class="site-nav__link site-nav__reserve" href="reserve.html"{% if current == 'reserve' %} aria-current="page"{% endif %}>ご予約</a></li>
        </ul>
      </nav>
    </div>
  </header>
{%- endmacro %}

{% macro breadcrumb(current_name, current_url='') -%}
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <div class="container">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a class="breadcrumb__link" href="index.html">ホーム</a></li>
        <li class="breadcrumb__item" aria-current="page">{{ current_name }}</li>
      </ol>
    </div>
  </nav>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "ホーム",
        "item": "https://ehimenomasa.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ current_name }}"{% if current_url %},
        "item": "{{ current_url }}"{% endif %}
      }
    ]
  }
  </script>
{%- endmacro %}

{% macro site_footer(site, access, tel, css_v, mobile_bar='default') -%}
  <footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <img src="assets/images/site/logo-masachan.webp" alt="愛媛の雅ちゃん" width="400" height="146" loading="lazy" decoding="async">
          <p class="footer-brand__tag">焼き・揚げ鳥 〜愛媛の雅ちゃん〜</p>
          <p class="footer-brand__place">松山市駅から徒歩1分</p>
        </div>
        <div class="footer-cta">
          <a class="footer-cta__btn footer-cta__btn--reserve" href="reserve.html">ご予約</a>
          <a class="footer-cta__btn footer-cta__btn--tel" href="{{ tel }}" data-reserve-gate="tel">電話する（{{ site.phone }}）</a>
        </div>
      </div>

      <dl class="footer-info">
        <div class="footer-info__row">
          <dt>住所</dt>
          <dd>{{ access.address }}</dd>
        </div>
        <div class="footer-info__row">
          <dt>TEL</dt>
          <dd><a href="{{ tel }}">{{ site.phone }}</a></dd>
        </div>
        <div class="footer-info__row">
          <dt>営業時間</dt>
          <dd>{% if access.hours %}{{ access.hours }}{% else %}17:30〜22:30（料理L.O.21:40／ドリンクL.O.22:10）{% endif %}</dd>
        </div>
        <div class="footer-info__row">
          <dt>定休日</dt>
          <dd>日曜日・祝日</dd>
        </div>
        <div class="footer-info__row">
          <dt>アクセス</dt>
          <dd>松山市駅から徒歩1分（北側出口すぐ）</dd>
        </div>
      </dl>

      <div class="footer-links">
        <nav class="footer-nav" aria-label="フッターメニュー">
          <p class="footer-label">メニュー</p>
          <div class="footer-nav__list">
            <a href="index.html">ホーム</a>
            <a href="menu.html">お品書き</a>
            <a href="course.html">宴会・コース</a>
            <a href="shop.html">店内・アクセス</a>
            <a href="about.html">雅ちゃんについて</a>
            <a href="recruit.html">スタッフ募集</a>
            <a href="takeout.html">テイクアウト</a>
            <a href="reserve.html">ご予約</a>
            <a href="privacy.html">プライバシーポリシー</a>
          </div>
        </nav>
        <div class="footer-sns">
          <p class="footer-label">各種SNS</p>
          <div class="footer-sns__list">
            {% if site.instagramUrl %}<a href="{{ site.instagramUrl }}" target="_blank" rel="noopener noreferrer">Instagram</a>{% endif %}
            {% if site.storesUrl %}<a href="{{ site.storesUrl }}" target="_blank" rel="noopener noreferrer">ネットショップ</a>{% endif %}
          </div>
        </div>
      </div>

      <div class="footer-copy">
        <p>Copyright © 愛媛の雅ちゃん / 株式会社 雅道</p>
      </div>
    </div>
  </footer>
  <div class="mobile-bar" aria-label="スマートフォン用クイックアクション">
    <div class="mobile-bar__inner">
      {% if mobile_bar == 'recruit' %}
      <a class="mobile-bar__btn mobile-bar__btn--reserve" href="#recruit-apply">WEB応募</a>
      <a class="mobile-bar__btn mobile-bar__btn--tel" href="{{ tel }}">電話で応募</a>
      {% else %}
      <a class="mobile-bar__btn mobile-bar__btn--reserve" href="reserve.html">予約する</a>
      <a class="mobile-bar__btn mobile-bar__btn--tel" href="{{ tel }}" data-reserve-gate="tel">電話する</a>
      {% endif %}
    </div>
  </div>
  <script src="js/main.js?v=20260923z"></script>
{%- endmacro %}
